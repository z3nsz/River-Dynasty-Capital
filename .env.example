# ---------------------------------------------------------------------------
# River Dynasty Capital — environment variables
# Copy this file to `.env.local` and fill in the values. Never commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (required) ---------------------------------------------------
# From your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Settings -> API -> "service_role" secret. Server-only. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- Stock price API (optional but recommended) --------------------------
# Finnhub free tier: https://finnhub.io/dashboard
# If unset, the site falls back to the manual "current price" field per holding.
FINNHUB_API_KEY=your-finnhub-key

# --- Admin auth (required to use /admin) ---------------------------------
# The single password for the admin panel.
ADMIN_PASSWORD=choose-a-long-random-password
# Random 32+ character string used to sign the admin session cookie.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=generate-a-32-plus-char-random-string

# --- Scheduled price refresh (optional) --------------------------------
# Shared secret required by /api/cron/refresh. Generate with: openssl rand -hex 16
CRON_SECRET=generate-a-random-string

# --- Tuning (optional; defaults shown) --------------------------------
# Benchmark symbol. SPY (S&P 500 ETF) works on Finnhub's free tier. ^GSPC does not.
NEXT_PUBLIC_BENCHMARK_SYMBOL=SPY
# How stale (seconds) the server price cache may get before a page view triggers
# a background refresh (only while the US market is open).
PRICE_CACHE_TTL_SECONDS=120

# --- Optional: browser websocket live-tick ----------------------------
# Enables real-time price ticking via Finnhub's websocket while the US market is
# open. WARNING: this token is sent to the browser and is therefore public.
# Use a SEPARATE Finnhub key here, not the one in FINNHUB_API_KEY. Leave blank
# to disable (the site will poll every 60s instead, which is fine).
NEXT_PUBLIC_FINNHUB_TOKEN=
